# App
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Database
DATABASE_URL="postgresql://ecp_user:ecp_password@localhost:5433/ecp_db?schema=public"

# JWT
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# Throttling (requests per ttl window, seconds)
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Redis (used from Week 5-6 onward for BullMQ / caching)
REDIS_HOST=localhost
REDIS_PORT=6379
